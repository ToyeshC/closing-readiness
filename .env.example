# Required — Anthropic API key for Claude advisory + guided-diagnosis calls.
# Sonnet 4.6 is the default model; override via ANTHROPIC_MODEL if needed.
ANTHROPIC_API_KEY=your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-6

# LangWatch observability — traces every LLM + engine call so you can see the
# guardrail working live (guided-diagnosis vs advisory path, input/output).
LANGWATCH_API_KEY=your_key_here

# Required on Railway/production — used by FastAPI CORS config and OAuth post-callback redirect.
FRONTEND_URL=https://your-vercel-url.vercel.app

# Optional override — defaults to "00 Dataroom hackathon" relative to repo root.
DATA_FOLDER=00 Dataroom hackathon

# Where the tax-filing PDFs live (CIT, VAT, Wage Tax). Ships in repo at demo_seed/tax_pdfs
# so the three PDF-based checks work on Railway (the original 00 Dataroom folder is gitignored).
TAX_PDF_DIR=demo_seed/tax_pdfs

# Exact Online OAuth credentials (from developer portal / organiser).
EXACT_CLIENT_ID=1059f79f-4e33-4205-b181-6cb028b4a723
EXACT_CLIENT_SECRET=your-secret-here
# Must match the redirect URI registered in the Exact Online developer portal.
# Dev: ngrok static domain. Prod: the Railway app URL (register both in portal).
EXACT_REDIRECT_URI=https://unwired-sweep-apostle.ngrok-free.dev/auth/exact/callback

# On Railway, set this to /data/oauth_tokens.db and mount a Volume at /data so
# tokens survive container restarts. Locally it defaults to oauth_tokens.db.
# TOKEN_DB_PATH=/data/oauth_tokens.db
