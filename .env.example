# Required — Anthropic API key for Claude advisory calls (only invoked when advice_ready=True)
ANTHROPIC_API_KEY=your-key-here

# Required on Railway/production — used by FastAPI CORS config
FRONTEND_URL=https://your-vercel-url.vercel.app

# Optional override — defaults to "00 Dataroom hackathon" relative to repo root
DATA_FOLDER=00 Dataroom hackathon
